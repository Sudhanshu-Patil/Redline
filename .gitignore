# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
dist/
build/

# uv
.python-version

# Env / secrets
.env
*.env.local

# Data artifacts generated at runtime (keep committed sample inputs, ignore generated outputs)
traces/*.jsonl
traces/*.json
!traces/.gitkeep
data/samples/generated/
# Pair 5's duplicated-content dumps are large (~4MB each) and deterministically
# regenerable (uv run python scripts/stress_test_pair5.py) -- the measured
# stress_results.json (small, the actual evidence) stays committed.
data/samples/pair5/*.canonical.json
chroma_db/
dashboard_runs/
# CI's own --delta-only run, distinct from the committed real eval/scorecard.json
eval/scorecard_ci.json
*.db

# Models cache
.cache/
models_cache/

# Claude Code harness-internal state
.claude/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
