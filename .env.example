# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---
# "anthropic" (Claude via anthropic SDK) or "openai_compatible" (any provider
# speaking the OpenAI chat-completions format: Groq, Moonshot/Kimi, OpenRouter...)
LLM_PROVIDER=anthropic

# -- anthropic backend --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# -- openai_compatible backend --
# Recipe A, Groq free tier (https://console.groq.com), live-verified 2026-07:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_VISION_MODEL=qwen/qwen3.6-27b        (multimodal reasoning model)
# Recipe B, Moonshot/Kimi direct (https://platform.moonshot.ai):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.moonshot.ai/v1
#   LLM_MODEL=<a kimi model id from GET /v1/models>
#   LLM_VISION_MODEL=<a kimi vision-capable model id>
#   LLM_VISION_REASONING_HIDDEN=false        (reasoning_format is Groq-specific)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_VISION_MODEL=qwen/qwen3.6-27b
# Reasoning vision models burn hidden tokens before answering
LLM_VISION_MAX_TOKENS=3000
LLM_VISION_REASONING_HIDDEN=true

# -- shared --
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
# Free tiers rate-limit aggressively with a stated wait; honor it up to this
# many seconds per call before giving up (0 disables waiting).
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=120
# $/MTok used for cost telemetry (Sonnet 5 sticker; set to 0 for free tiers)
LLM_COST_PER_MTOK_INPUT=3.0
LLM_COST_PER_MTOK_OUTPUT=15.0

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# --- Delta alignment thresholds ---
ALIGNMENT_EMBEDDING_SIMILARITY_THRESHOLD=0.75
ALIGNMENT_BBOX_PROXIMITY_TOLERANCE=0.02
ALIGNMENT_TIER3_LOOSE_PROXIMITY=0.15
ALIGNMENT_MIN_EMBED_TEXT_LEN=2
GEOMETRY_MATCH_MAX_BBOX_DISTANCE=0.3
GEOMETRY_MATCH_UNNAMED_MAX_BBOX_DISTANCE=0.03
# Threshold on the exact-key match rate (not overall alignment); see src/config.py
LOW_ALIGNMENT_RATE_THRESHOLD=0.5
LOW_ALIGNMENT_MIN_ELEMENTS=20
LOW_KEYED_FRACTION_THRESHOLD=0.05
LOW_KEYED_FRACTION_MIN_ELEMENTS=20

# --- OCR ---
OCR_CONFIDENCE_THRESHOLD=60
OCR_DPI=300
# Tesseract page segmentation mode; 11 = sparse text, best for line-art-dense drawings
OCR_TESSERACT_PSM=11
# Explicit tesseract binary path; empty = PATH, then well-known install dirs
# (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe on Windows)
TESSERACT_CMD=

# --- Vision-LLM fallback for low-confidence OCR regions ---
VISION_FALLBACK_ENABLED=true
VISION_FALLBACK_MAX_REGIONS=12
VISION_FALLBACK_CONFIDENCE=0.9

# --- DWG/DXF ---
# Path to ODA File Converter for binary .dwg inputs; empty = PATH lookup.
# .dxf files are parsed directly and need no converter.
ODA_FILE_CONVERTER=
DWG_DIM_DECIMALS=1

# --- Paths ---
DATA_DIR=./data
TRACES_DIR=./traces
CHROMA_PERSIST_DIR=./chroma_db
DASHBOARD_RUNS_DIR=./dashboard_runs

# --- Observability ---
LOG_LEVEL=INFO
METRICS_HOST=127.0.0.1
METRICS_PORT=8000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8001
DASHBOARD_MAX_UPLOAD_MB=50
