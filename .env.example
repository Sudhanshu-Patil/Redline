# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=

# Model names are config, not hardcoded (see src/config.py). Override per environment/cost tier.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# --- Delta alignment thresholds ---
ALIGNMENT_EXACT_MATCH_CONFIDENCE=0.95
ALIGNMENT_EMBEDDING_SIMILARITY_THRESHOLD=0.75
ALIGNMENT_BBOX_PROXIMITY_TOLERANCE=0.02

# --- OCR ---
OCR_CONFIDENCE_THRESHOLD=60
OCR_DPI=300

# --- Paths ---
DATA_DIR=./data
TRACES_DIR=./traces
CHROMA_PERSIST_DIR=./chroma_db

# --- Observability ---
LOG_LEVEL=INFO
